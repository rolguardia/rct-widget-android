<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/competition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RUGBY • TOP 14"
        android:textColor="#F1B7B7"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/match_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Prochain match du RCT"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="2" />

    <TextView
        android:id="@+id/match_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Date à configurer"
        android:textColor="#D8DDEA"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="DIFFUSION TV"
        android:textColor="#B8C2D7"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/match_channel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Diffusion à confirmer"
        android:textColor="#F3C66B"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="2" />

    <TextView
        android:id="@+id/updated_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="Données de démonstration"
        android:textColor="#9FAAC0"
        android:textSize="10sp" />
</LinearLayout>
